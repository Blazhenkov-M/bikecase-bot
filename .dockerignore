# Исключаем стандартные временные и кэш-файлы Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyc
*.pyo
*.pyd

# Исключаем тесты
/tests/

# Исключаем логи
logs/
*.log

# Исключаем git-репозиторий
.git/
.gitignore

# Исключаем IDE-файлы
*.swp
*.swo
*.idea/
*.vscode/

# Исключаем Dockerfile и docker-compose.yml (копируются только если явно нужно)
Dockerfile
docker-compose.yml

# Исключаем файлы окружения (копируются только если явно нужно)
.env

# Локальное venv не нужно в образе
.venv/
venv/

# Исключаем временные файлы и дампы
*.db
*.sqlite3
*.bak
*.tmp

# Исключаем файлы и каталоги, которые не нужны в контейнере
README.md
accounts.json
sessions/

# Исключаем любые другие временные или вспомогательные файлы
*.orig
*.old
*.backup

# Исключаем файлы macOS
.DS_Store 